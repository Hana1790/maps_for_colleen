## Calculate Flux for N2 and O2 dissolved gases

copy code from above nutrient flux calc but change variable names for N2 and O2
https://www.rdocumentation.org/packages/mimsy/versions/0.6.5/topics/mimsy

I did not record the barometric pressure during the days I ran the MIMS so I am looking at the localconditions.com which uses NOAA METAR and Radar Weather data-sets https://www.localconditions.com/about.php, https://weatherspark.com/h/d/18170/2026/3/3/Historical-Weather-on-Tuesday-March-3-2026-in-Kent-Ohio-United-States#metar-11-51

My three run dates: 
-March 3 (started at 11) 30.16inHG
-March 6 (started at 10) 30.18inHG
-March 17 (started at 9) 29.92inHG

```{r}
library(tidyverse)
library(forcats) #deciding order of bars
library(patchwork) #stacking plot panels
library(cowplot) #stacking plot panels
library(ggpubr) #prints correlation on ggplot
library(mimsy)
library(readxl)

#enter in the data
data_gas1 <- read.csv("./data/2026_MIMS_TRUC_ICI_Data/mimsy_20260303_HEsber_TRUC_ICI_gas_run1.csv", stringsAsFactors = T)
data_gas2 <- read.csv("./data/2026_MIMS_TRUC_ICI_Data/mimsy_20260306_HEsber_TRUC_ICI_gas_run2.csv", stringsAsFactors = T)
data_gas3 <- read.csv("./data/2026_MIMS_TRUC_ICI_Data/mimsy_20260317_HEsber_TRUC_ICI_gas_run3.csv", stringsAsFactors = T)
#Ran data on 3 separate days to get them all done. They all have different drift values associated with them

# Look at the data frames
str(data_gas1)
head(data_gas1)
View(data_gas1)

## account for drift - converted inHG to atm
# 30.16= 1.008, 30.18= 1.009, 29.92= 1.00

# using mimsy to calculate the baseline drift - run 1 (3/3/26)
gas1_results <- mimsy(data_gas1, baromet.press = 1.01, units='atm')
gas1_results
mimsy.save(gas1_results, "./data/2026_MIMS_TRUC_ICI_Data/mimsyCalcs_20260303_run1.xlsx")

# using mimsy to calculate the baseline drift - run 2 (3/6/26)
gas2_results <- mimsy(data_gas2, baromet.press = 1.01, units='atm')
gas2_results
mimsy.save(gas2_results, "./data/2026_MIMS_TRUC_ICI_Data/mimsyCalcs_20260306_run2.xlsx")

# using mimsy to calculate the baseline drift - run 3 (3/17/26)
gas3_results <- mimsy(data_gas3, baromet.press = 1.00, units='atm') #lower pressure this day
gas3_results
mimsy.save(gas3_results, "./data/2026_MIMS_TRUC_ICI_Data/mimsyCalcs_20260317_run3.xlsx")

# Read in excel files - combine all of these spreadsheets
#make a list of files
files <- list(mimsy1= "./data/2026_MIMS_TRUC_ICI_Data/mimsyCalcs_20260303_run1.xlsx",
              mimsy2= "./data/2026_MIMS_TRUC_ICI_Data/mimsyCalcs_20260306_run2.xlsx", 
              mimsy3= "./data/2026_MIMS_TRUC_ICI_Data/mimsyCalcs_20260317_run3.xlsx")

#one big excel sheet of results data
files %>%
  map_dfr(read_excel) %>%  # map_dfr automatically binds rows
  write.csv(., "./data/2026_MIMS_TRUC_ICI_Data/Combined_gas_results_2025.csv", row.names = FALSE)
 
```

