library(forcats) #deciding order of bars

# barplot of NO3 flux
barplot_no3_flux <- NO3_flux %>% 
  mutate(habitat = fct_relevel(habitat, 
            "dry", "slightly_inundated", "more_inundated", 
            "standing_water", "fully_inundated")) %>%
  group_by(habitat) %>% 
  summarize(m = mean(NO3_flux_mg_m2_d, na.rm = TRUE),
            se = sd(NO3_flux_mg_m2_d, na.rm = TRUE)/sqrt(3)) %>% 
  ggplot(aes(x = habitat, y = m)) + 
  geom_bar(stat = "identity", 
           color = "black", 
           position = position_dodge(0), 
           width = 0.8, 
           fill = "#785EF0") + 
  geom_errorbar(aes(ymin = m-se, ymax = m+se), 
                width = .2,
                position = position_dodge(.8)) +
  geom_point(data = NO3_flux, aes(x = habitat, y = NO3_flux_mg_m2_d, shape=time),
             position = position_dodge(), 
             size = 2) + 
  labs(title = "Sediment and Surface Water Flux of NOx", 
       x = NULL, 
       y = expression("NO"["3"]^" -" * " Flux" * " (mg/m"^"2"*"/d)"), 
       shape = " Time")+
  scale_x_discrete(labels = c("Dry", "Slightly\nInundated", "Moderately\nInundated", "Fully\nInundated", "Standing\nWater")) +
  theme_classic() + 
  ylim(-2,3) + 
  theme(text = element_text(size = 15)) + 
  theme(plot.title = element_text(hjust = 0.5)) +
