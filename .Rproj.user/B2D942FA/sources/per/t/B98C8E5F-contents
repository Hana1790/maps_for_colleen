```{r}
# reading in mastersheet first
mastersheet <- read_csv("./data/20251208_SkalarData_NOx_OP_NH3_mastersheet.csv")

# removing the outliers before processing
mastersheet <- mastersheet %>%
  mutate(out_NO3_ugL = na_if(out_NO3_ugL, 410.82),
         NO3_flux_mg_m2_d = na_if(NO3_flux_mg_m2_d, 151.429824))

# Taking the average for NH3,NOx, Ortho P from each core over 3 time periods
core_nutrient_fluxes <- mastersheet %>% 
  group_by(core_id) %>% # sqrt of sum of the number, bc I removed outliers
  summarize(NO3_n = sum(!is.na(NO3_flux_mg_m2_d)),
            NO3_flux_mg_m2_d = mean(NO3_flux_mg_m2_d, na.rm = TRUE),
            NH3_n = sum(!is.na(NH3_flux_mg_m2_d)),
            NH3_flux_mg_m2_d = mean(NH3_flux_mg_m2_d, na.rm = TRUE),
            oP_n = sum(!is.na(oP_flux_mg_m2_d)),
            oP_flux_mg_m2_d = mean(oP_flux_mg_m2_d, na.rm = TRUE)) %>%
  mutate(NO3_SE = sd(NO3_flux_mg_m2_d, na.rm = TRUE) / sqrt(NO3_n),
         NH3_SE = sd(NH3_flux_mg_m2_d, na.rm = TRUE) / sqrt(NH3_n),
         oP_SE = sd(oP_flux_mg_m2_d, na.rm = TRUE) / sqrt(oP_n),
    NO3_color = ifelse(NO3_flux_mg_m2_d > 0, "Release", "Retention"),
    NH3_color = ifelse(NH3_flux_mg_m2_d > 0, "Release", "Retention"),
    oP_color = ifelse(oP_flux_mg_m2_d > 0, "Release", "Retention")) 
  # if flux > 0, then release, if not, retention

# plot NO3 average flux per core
barplot_core_NO3 <- core_nutrient_fluxes %>% 
  ggplot(aes(x = core_id, y = NO3_flux_mg_m2_d, fill = NO3_color)) +
    geom_col(color = "black",
             width = 0.8,
             alpha = 0.85) +
    geom_errorbar(aes(ymin = NO3_flux_mg_m2_d - NO3_SE, 
                      ymax = NO3_flux_mg_m2_d + NO3_SE),
                width = 0.2) +
  scale_fill_manual(values = c("Release" = "#daa520",
                               "Retention" = "#228B22")) +
  labs(title = "Sediment and Surface Water Flux of Dissolved NO3",
       x = NULL,
       y = expression("NO3 Flux" * " (mg/m"^"2"*"/d)"),
       fill = "Average Flux") +
  geom_hline(yintercept = 0, linewidth = 1) +
  theme_bw() +
  theme(
    plot.title = element_text(hjust = 0.5),
    text = element_text(size = 18),
    legend.position = "bottom")

