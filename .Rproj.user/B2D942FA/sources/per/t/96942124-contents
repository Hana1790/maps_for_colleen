depth_quadrats$year = year(depth_quadrats$date)
depth_quadrats$month = month(depth_quadrats$date)
depth_quadrats <- depth_quadrats %>% # add in the wateryear
  mutate(year_num = as.numeric(as.character(year)), wateryear = case_when(month %in% c(10, 11, 12) ~ year_num + 1,TRUE ~ year_num)) %>%  select(-year_num)  


depth_quadrats %>% group_by(wateryear) %>%
  summarise(across(-date, ~ sum(.x > 0, na.rm = TRUE)))
