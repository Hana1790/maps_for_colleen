Combing everything together! 
```{r}
# take out the Water.Depth columns and join our dfs
depth_quadrats <- depth36_quadrats %>% select(!"Water.Depth") %>%
  full_join(depth42_quadrats %>% select(!"Water.Depth"), by = "date") %>%
  full_join(depth39_quadrats %>% select(!"Water.Depth"), by = "date") %>%
  full_join(depth40_quadrats %>% select(!"Water.Depth"), by = "date")

head(depth_quadrats)
write.csv(depth_quadrats, "annual-report/veg_accretion/depth_quadrats.csv", row.names = FALSE)
